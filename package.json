{
  "name": "vui",
  "version": "0.1.0",
  "description": "轻量 Vue3 + TypeScript 组件库（Button / Icon / Input / Switch / Modal / Message / Form / Select / Checkbox / Radio / Tabs / Tag / Tooltip），基于 Vite library mode 构建，含类型声明与 Vitest 单测。",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vui.umd.cjs",
  "module": "./dist/vui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vui.js",
      "require": "./dist/vui.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "vue3",
    "typescript",
    "component-library",
    "ui"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "lavamoat": {
    "allowScripts": {
      "esbuild": true,
      "@parcel/watcher": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.5",
    "jsdom": "^24.0.0",
    "sass": "^1.77.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
